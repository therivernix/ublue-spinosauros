[Unit]
Description=Install Silverblue Setup
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/flatpak/app/io.github.silverblue.SetupWizard

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
ExecStart=/usr/bin/flatpak install --system --noninteractive flathub org.gnome.Platform//51
ExecStart=/usr/bin/flatpak install --system --noninteractive --bundle /usr/share/ublue-os-spinosauros/flatpaks/io.github.silverblue.SetupWizard.flatpak

[Install]
WantedBy=multi-user.target
