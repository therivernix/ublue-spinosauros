[/]
control-center=['AudioMedia']
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom2/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom3/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom5/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom6/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom7/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom8/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom9/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom11/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom12/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom13/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom14/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom15/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/']
media-static=['gnome-control-center']

[custom-keybindings/custom0]
binding='<Super>Return'
command='xdg-terminal-exec'
name='Terminal'

[custom-keybindings/custom1]
binding='<Shift><Super>p'
command='firefox --private-window'
name='Firefox Private Session'

[custom-keybindings/custom11]
binding='<Shift><Super>g'
command='flatpak run org.signal.Signal'
name='Signal'

[custom-keybindings/custom12]
binding='<Super>Print'
command='flatpak run be.alexandervanhee.gradia --screenshot=INTERACTIVE'
name='Gradia'

[custom-keybindings/custom13]
binding='<Super>i'
command='gnome-control-center'
name='Settings'

[custom-keybindings/custom14]
binding='<Super>u'
command='xdg-terminal-exec -- /usr/bin/ujust update'
name='Update'

[custom-keybindings/custom15]
binding='<Super>k'
command='gnome-control-center keyboard'
name='Settings Keyboard'

[custom-keybindings/custom2]
binding='<Control><Shift>Escape'
command='flatpak run io.missioncenter.MissionCenter'
name='mission-center'

[custom-keybindings/custom3]
binding='<Control><Alt>BackSpace'
command='flatpak run com.jeffser.Alpaca'
name='Launch Alpaca'

[custom-keybindings/custom4]
binding='<Super>e'
command='nautilus'
name='Nautilus'

[custom-keybindings/custom5]
binding='<Control><Alt>space'
command='flatpak run it.mijorus.smile'
name='Open up the emoji picker'

[custom-keybindings/custom6]
binding='<Super>period'
command='flatpak run it.mijorus.smile'
name='Open up the emoji picker (Alt)'

[custom-keybindings/custom7]
binding='<Shift><Super>b'
command='firefox'
name='Firefox'

[custom-keybindings/custom8]
binding='<Shift><Super>o'
command='flatpak run md.obsidian.Obsidian'
name='Obsidian'

[custom-keybindings/custom9]
binding='<Shift><Super>f'
command='flatpak run com.fastmail.Fastmail'
name='Fastmail'
